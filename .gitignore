# Training datasets (large, not tracked)
cme_training_short_data/
backend/data/processed_*
backend/data/final_processed

# Raw FITS and intermediate PNGs (too large for git)
# Annotated PNGs (~200 KB each) ARE committed
backend/data/cached/*/*/raw/
backend/data/cached/*/*/png/
backend/data/cached/*/*/diff/

# ML artifacts
*.pt
*.pth
*.onnx
*.pkl
*.joblib
*.npy
*.npz
# ...except the 6 quantile checkpoints (~470 KB total). Without them a fresh
# clone silently degrades to conservative fallback predictions.
!backend/ml/checkpoints/*.pkl

*.env
.venv/
venv/
__pycache__/
.pytest_cache/


frontend/public/frames_for_scrolling_frontend
SKILL_ui_ux_in_txt.txt
frontend_prompt.md

# Frontend (Next.js) ignores
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*.local
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/ezgif-664f0582ff119a0b-jpg.zip

# Terraform state
deployment/infra/**/.terraform/
deployment/infra/**/terraform.tfstate
deployment/infra/**/terraform.tfstate.backup
deployment/infra/**/*.tfvars
!deployment/infra/environments/*/terraform.tfvars.example

# Docker local builds
.docker/

# opencode config
.opencode/

frontend/dist/
.ruff_cache/

# EDA plots are regenerated by 01_data_generation_eda.py alongside the CSV.
# synthetic_storms.csv itself IS committed: it is the training set the served
# checkpoints came from, 260 KB, and reproducible only because the seed is fixed.
backend/ml/data/eda_plots/

# HelioOps Backend Configuration
# Copy this file to .env and fill in values

# ── Server ────────────────────────────────────────────
HELIOOPS_HOST=0.0.0.0
HELIOOPS_PORT=8000
HELIOOPS_WORKERS=1
HELIOOPS_RELOAD=true

# ── Logging ───────────────────────────────────────────
HELIOOPS_LOG_LEVEL=INFO
# Options: json, console
HELIOOPS_LOG_FORMAT=json

# ── LLM (required) ───────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048

# ── Self-check LLM (optional, lighter model saves tokens) ──
GROQ_CHECKER_MODEL=llama-3.1-8b-instant

# ── Token Budget (optional) ──────────────────────────
MAX_PROMPT_TOKENS=4000

# ── ML ────────────────────────────────────────────────
HELIOOPS_ML_CHECKPOINT_DIR=ML_after_CV/checkpoints

# ── RAG ───────────────────────────────────────────────
HELIOOPS_CHROMA_PERSIST_PATH=data/chroma_db

# ── CORS (optional) ──────────────────────────────────
# HELIOOPS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# HelioOps Backend Configuration
# Copy this file to .env and fill in values

# ── Server ────────────────────────────────────────────
HELIOOPS_HOST=0.0.0.0
HELIOOPS_PORT=8000
HELIOOPS_WORKERS=1
HELIOOPS_RELOAD=true

# ── Logging ───────────────────────────────────────────
HELIOOPS_LOG_LEVEL=INFO
# Options: json, console
HELIOOPS_LOG_FORMAT=json

# ── LLM (required) ───────────────────────────────────
# Check the live model list before changing these — Groq decommissions models:
#   python -c "from groq import Groq; print([m.id for m in Groq().models.list().data])"
GROQ_API_KEY=gsk_your_key_here
# Optional key pool. Groq meters TPM per (key, model), so each extra key is a
# full extra budget and cuts wall time roughly linearly. Supersedes
# GROQ_API_KEY when set. Buys throughput only — not accuracy, and not a larger
# context window (we use 3% of the 131k window as it is).
# GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1200
# gpt-oss are reasoning models and CoT is billed against max_tokens.
# "low" is what keeps the advisory JSON from being truncated.
GROQ_REASONING_EFFORT=low

# ── Self-check LLM (separate model = separate TPM bucket) ──
GROQ_CHECKER_MODEL=openai/gpt-oss-20b
GROQ_CHECKER_MAX_TOKENS=512

# ── Rate limiting ────────────────────────────────────
# Free-tier Groq meters 8000 tokens/min PER MODEL. Raise on a paid key.
GROQ_TPM_LIMIT=8000
GROQ_MAX_RETRIES=4
GENAI_MAX_CONCURRENCY=2

# ── Token Budget (optional) ──────────────────────────
# Whole-prompt ceiling. ~1100 of it is fixed overhead (system prompt, JSON
# schema block, storm section); the remainder budgets retrieved RAG chunks.
# With a pooled key set, 4300 / RAG_TOP_K=5 is the better pair — see the
# measurement note in backend/genai/config.py before changing either.
MAX_PROMPT_TOKENS=3000
RAG_TOP_K=3

# ── ML ────────────────────────────────────────────────
HELIOOPS_ML_CHECKPOINT_DIR=backend/ml/checkpoints

# ── RAG ───────────────────────────────────────────────
HELIOOPS_CHROMA_PERSIST_PATH=backend/data/chroma_db

# ── CORS (optional) ──────────────────────────────────
# HELIOOPS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Storage Backend ──────────────────────────────────
# Options: memory (default), supabase
HELIOOPS_RESULT_REPOSITORY=memory

# ── Supabase (required only if RESULT_REPOSITORY=supabase) ──
HELIOOPS_SUPABASE_URL=https://your-project.supabase.co
HELIOOPS_SUPABASE_ANON_KEY=your_anon_key_here
